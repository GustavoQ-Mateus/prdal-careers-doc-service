{
  "openapi": "3.0.4",
  "info": {
    "title": "doc-service",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "doc-service"
        ],
        "operationId": "health",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/render/docx": {
      "post": {
        "tags": [
          "doc-service"
        ],
        "operationId": "renderDocx",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenderRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/vnd.openxmlformats-officedocument.wordprocessingml.document": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroResponse"
                }
              }
            }
          },
          "413": {
            "description": "Payload Too Large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "tokenServico": []
          }
        ]
      }
    },
    "/render/pdf": {
      "post": {
        "tags": [
          "doc-service"
        ],
        "operationId": "renderPdf",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenderRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "X-Paginas": {
                "description": "Numero de paginas medido pelo QuestPDF",
                "required": true,
                "schema": {
                  "minimum": 1,
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroResponse"
                }
              }
            }
          },
          "413": {
            "description": "Payload Too Large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "tokenServico": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ErroResponse": {
        "required": [
          "erro"
        ],
        "type": "object",
        "properties": {
          "erro": {
            "type": "string"
          }
        }
      },
      "HealthResponse": {
        "required": [
          "service",
          "status"
        ],
        "type": "object",
        "properties": {
          "service": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "RenderRequest": {
        "required": [
          "markdown",
          "template"
        ],
        "type": "object",
        "properties": {
          "markdown": {
            "type": "string"
          },
          "template": {
            "type": "string",
            "nullable": true
          }
        }
      }
    },
    "securitySchemes": {
      "tokenServico": {
        "type": "apiKey",
        "name": "X-Prdal-Servico",
        "in": "header"
      }
    }
  },
  "tags": [
    {
      "name": "doc-service"
    }
  ]
}
